import { execFile } from "node:child_process";
import { promisify } from "node:util";

import type { GitStats } from "../core/types.js";

const exec = promisify(execFile);

async function git(
  repositoryPath: string,
  args: string[]
): Promise<string> {
  const result = await exec(
    "git",
    ["-C", repositoryPath, ...args]
  );

  return result.stdout.trim();
}

export async function analyzeGit(
  repositoryPath: string
): Promise<GitStats | null> {
  try {
    await git(repositoryPath, ["rev-parse", "--is-inside-work-tree"]);

    const branch = await git(
      repositoryPath,
      ["branch", "--show-current"]
    );

    const commitOutput = await git(
      repositoryPath,
      ["rev-list", "--count", "HEAD"]
    );

    const contributorOutput = await git(
      repositoryPath,
      ["shortlog", "-sne", "HEAD"]
    );

    const status = await git(
      repositoryPath,
      ["status", "--porcelain"]
    );

    let remote: string | undefined;

    try {
      remote = await git(
        repositoryPath,
        ["remote", "get-url", "origin"]
      );
    } catch {
      remote = undefined;
    }

    return {
      branch: branch || "detached",
      commits: Number(commitOutput) || 0,
      contributors: contributorOutput
        ? contributorOutput.split("\n").length
        : 0,
      clean: status.length === 0,
      remote
    };
  } catch {
    return null;
  }
}


