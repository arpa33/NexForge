import fs from "node:fs/promises";
import path from "node:path";

import type { DependencyStats } from "../core/types.js";

export async function analyzeDependencies(
  repositoryPath: string
): Promise<DependencyStats | null> {
  const packageJsonPath = path.join(
    repositoryPath,
    "package.json"
  );

  try {
    const raw = await fs.readFile(
      packageJsonPath,
      "utf8"
    );

    const pkg = JSON.parse(raw);

    return {
      runtime: Object.keys(
        pkg.dependencies ?? {}
      ).length,

      development: Object.keys(
        pkg.devDependencies ?? {}
      ).length,

      packageManager:
        pkg.packageManager ??
        detectPackageManager(repositoryPath)
    };
  } catch {
    return null;
  }
}

function detectPackageManager(
  repositoryPath: string
): string {
  return "npm";
}


