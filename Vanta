import fs from "node:fs/promises";
import path from "node:path";
import {
  walkDirectory,
  extensionOf
} from "../utils/filesystem.js";
import type {
  RepositoryStats,
  ProjectMetrics
} from "../core/types.js";

export async function analyzeStructure(
  repositoryPath: string
): Promise<{
  stats: RepositoryStats;
  metrics: ProjectMetrics;
}> {
  const files = await walkDirectory(repositoryPath);

  let directories = 0;
  let lines = 0;
  let sizeBytes = 0;

  const languages: Record<string, number> = {};
  const largestFiles: ProjectMetrics["largestFiles"] = [];

  for (const file of files) {
    const stat = await fs.stat(file);

    sizeBytes += stat.size;

    const extension = extensionOf(file);

    languages[extension] =
      (languages[extension] ?? 0) + 1;

    largestFiles.push({
      path: path.relative(repositoryPath, file),
      sizeBytes: stat.size
    });

    if (isTextFile(extension)) {
      try {
        const content = await fs.readFile(file, "utf8");
        lines += content.split(/\r?\n/).length;
      } catch {
        // Ignore unreadable files.
      }
    }
  }

  const directoriesSet = new Set(
    files.map((file) =>
      path.dirname(path.relative(repositoryPath, file))
    )
  );

  directories = directoriesSet.size;

  largestFiles.sort(
    (a, b) => b.sizeBytes - a.sizeBytes
  );

  const riskFlags: string[] = [];

  if (files.length === 0) {
    riskFlags.push("Repository contains no files");
  }

  if (sizeBytes > 500_000_000) {
    riskFlags.push("Repository exceeds 500MB");
  }

  if (files.some((file) =>
    file.toLowerCase().includes(".env")
  )) {
    riskFlags.push("Environment files detected");
  }

  return {
    stats: {
      path: repositoryPath,
      name: path.basename(repositoryPath),
      files: files.length,
      directories,
      lines,
      sizeBytes
    },
    metrics: {
      languages,
      largestFiles: largestFiles.slice(0, 10),
      riskFlags
    }
  };
}

function isTextFile(extension: string): boolean {
  return [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".json",
    ".md",
    ".txt",
    ".css",
    ".scss",
    ".html",
    ".yml",
    ".yaml",
    ".xml",
    ".py",
    ".go",
    ".rs",
    ".java",
    ".kt",
    ".c",
    ".cpp",
    ".h"
  ].includes(extension);
}


