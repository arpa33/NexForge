  .name("vanta")
  .description(
    "Repository intelligence CLI"
  )
  .version("1.0.0");

program
  .command("analyze")
  .description(
    "Analyze a local Git repository"
  )
  .argument(
    "[path]",
    "Repository path",
    "."
  )
  .action(analyzeCommand);

program
  .command("scan")
  .description(
    "Alias for analyze"
  )
  .argument(
    "[path]",
    "Repository path",
    "."
  )
  .action(analyzeCommand);

program.parseAsync(process.argv);


