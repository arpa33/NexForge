// src/analyzer/repository.ts
// ============================================================

import {
  analyzeStructure
} from "./structure.js";

import {
  analyzeGit
} from "./git.js";

import {
  analyzeDependencies
} from "./dependencies.js";

import type {
  RepositoryReport
} from "../core/types.js";

export async function analyzeRepository(
  repositoryPath: string
): Promise<RepositoryReport> {
  const [
    structure,
    git,
    dependencies
  ] = await Promise.all([
    analyzeStructure(repositoryPath),
    analyzeGit(repositoryPath),
    analyzeDependencies(repositoryPath)
  ]);

  return {
    repository: structure.stats,
    git,
    dependencies,
    metrics: structure.metrics,
    generatedAt: new Date().toISOString()
  };
}


