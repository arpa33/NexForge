import type {
  RepositoryReport
} from "./types.js";

export function renderReport(
  report: RepositoryReport
): void {
  const divider =
    "─".repeat(64);

  console.log("\n");
  console.log("VANTA REPOSITORY REPORT");
  console.log(divider);

  console.log(
    `Repository : ${report.repository.name}`
  );

  console.log(
    `Path       : ${report.repository.path}`
  );

  console.log(
    `Files      : ${report.repository.files}`
  );

  console.log(
    `Directories: ${report.repository.directories}`
  );

  console.log(
    `Lines      : ${report.repository.lines}`
  );

  console.log(
    `Size       : ${formatBytes(
      report.repository.sizeBytes
    )}`
  );

  console.log(divider);

  if (report.git) {
    console.log("GIT");

    console.log(
      `Branch     : ${report.git.branch}`
    );

    console.log(
      `Commits    : ${report.git.commits}`
    );

    console.log(
      `Contributors: ${report.git.contributors}`
    );

    console.log(
      `Working tree: ${
        report.git.clean
          ? "clean"
          : "modified"
      }`
    );

    if (report.git.remote) {
      console.log(
        `Remote     : ${report.git.remote}`
      );
    }
  } else {
    console.log("GIT");
    console.log("Not a Git repository");
  }

  console.log(divider);

  if (report.dependencies) {
    console.log("DEPENDENCIES");

    console.log(
      `Runtime    : ${report.dependencies.runtime}`
    );

    console.log(
      `Development: ${report.dependencies.development}`
    );

    console.log(
      `Manager    : ${report.dependencies.packageManager}`
    );
  }

  console.log(divider);

  console.log("LANGUAGE / FILE DISTRIBUTION");

  const languages = Object.entries(
    report.metrics.languages
  ).sort((a, b) => b[1] - a[1]);

  for (const [extension, count] of languages) {
    console.log(
      `  ${extension.padEnd(14)} ${count}`
    );
  }

  console.log(divider);

  console.log("LARGEST FILES");

  for (const file of report.metrics.largestFiles) {
    console.log(
      `  ${formatBytes(file.sizeBytes).padEnd(12)} ${file.path}`
    );
  }

  console.log(divider);

  console.log("RISK FLAGS");

  if (report.metrics.riskFlags.length === 0) {
    console.log("  No obvious structural risks detected.");
  } else {
    for (const flag of report.metrics.riskFlags) {
      console.log(`  ⚠ ${flag}`);
    }
  }

  console.log(divider);

  console.log(
    `Generated  : ${report.generatedAt}`
  );

  console.log("\n");
}

function formatBytes(bytes: number): string {
  if (bytes === 0) return "0 B";

  const units = [
    "B",
    "KB",
    "MB",
    "GB"
  ];

  const index = Math.floor(
    Math.log(bytes) / Math.log(1024)
  );

  return `${(
    bytes /
    Math.pow(1024, index)
  ).toFixed(2)} ${units[index]}`;
}


