import {
  scan
} from "../core/scanner.js";

import {
  renderReport
} from "../core/reporter.js";

export async function analyzeCommand(
  target: string
): Promise<void> {
  try {
    const report = await scan(target);

    renderReport(report);
  } catch (error) {
    const message =
      error instanceof Error
        ? error.message
        : "Unknown error";

    console.error(
      `Failed to analyze repository: ${message}`
    );

    process.exitCode = 1;
  }
}


